{
  "name": "note2video",
  "displayName": "Note2Video - MD to Animation",
  "description": "Convert Markdown notes to 3Blue1Brown-style teaching animations using Manim + LLM",
  "version": "0.1.0",
  "publisher": "24kchengYe",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Education", "Visualization", "Other"],
  "keywords": ["manim", "animation", "3blue1brown", "algorithm", "visualization", "markdown"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "note2video.animateFile",
        "title": "Note2Video: Animate This File",
        "icon": "$(play)"
      },
      {
        "command": "note2video.animateSelection",
        "title": "Note2Video: Animate Selection"
      },
      {
        "command": "note2video.configureApiKey",
        "title": "Note2Video: Configure API Key"
      },
      {
        "command": "note2video.openLastVideo",
        "title": "Note2Video: Open Last Video"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "note2video.animateFile",
          "group": "note2video@1"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == markdown",
          "command": "note2video.animateFile",
          "group": "note2video@1"
        },
        {
          "when": "editorHasSelection",
          "command": "note2video.animateSelection",
          "group": "note2video@2"
        }
      ],
      "editor/title": [
        {
          "when": "editorLangId == markdown",
          "command": "note2video.animateFile",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Note2Video",
      "properties": {
        "note2video.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable"
        },
        "note2video.apiGeneratePath": {
          "type": "string",
          "default": "D:/pythonPycharms/My_jupyerlab/tools/note2video/api_generate.py",
          "description": "Path to api_generate.py"
        },
        "note2video.platform": {
          "type": "string",
          "enum": ["openrouter", "mindcraft", "ablai"],
          "default": "openrouter",
          "description": "LLM API platform"
        },
        "note2video.model": {
          "type": "string",
          "default": "qwen/qwen3-235b-a22b",
          "description": "LLM model name"
        },
        "note2video.quality": {
          "type": "string",
          "enum": ["l", "m", "h"],
          "default": "m",
          "description": "Video quality: l=480p, m=720p, h=1080p"
        },
        "note2video.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key (stored in VS Code settings, or use .env file)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
